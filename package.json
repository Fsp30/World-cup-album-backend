	"bugs": {
		"url": "https://github.com/Fsp30/World-cup-album-backend/issues"
	},
	"homepage": "https://github.com/Fsp30/World-cup-album-backend#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@jest/globals": "^30.2.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.12.1",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.2.0",
		"jest": "^30.2.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.8.1",
		"ts-jest": "^29.4.6",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0"
	},
	"dependencies": {
		"date-fns": "^4.1.0"
